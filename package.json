{
  "name": "petanque-concours",
  "version": "0.2.0",
  "private": true,
  "description": "Gestion de concours de pétanque en SaaS avec mode hors-ligne (local-first)",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace shared --if-present && npm run build --workspace client && npm run build --workspace server",
    "test": "npm run test --workspace shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
